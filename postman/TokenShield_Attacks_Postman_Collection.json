  "item": [
    {
      "name": "1. Session Hijacking (Stolen Token Replay from Tor Node)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_YOUR_STOLEN_JWT_HERE",
            "description": "Paste the JWT token stolen from Chrome DevTools Application > Local Storage"
          },
          {
            "key": "X-Forwarded-For",
            "value": "185.220.101.5",
            "description": "Attacker IP: Known Tor Exit Node in Frankfurt, Germany"
          },
          {
            "key": "X-Real-IP",
            "value": "185.220.101.5"
          },
          {
            "key": "User-Agent",
            "value": "Mozilla/5.0 (X11; Linux x86_64; rv:109.0) Gecko/20100101 Firefox/115.0 (Kali Linux)",
            "description": "Attacker User-Agent differs from victim's Chrome browser"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 75000,\n  \"to_account\": \"ATTACKER-OFFSHORE-01\",\n  \"description\": \"Fraudulent Wire Transfer\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/banking/transfer",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "banking", "transfer"]
        },
        "description": "Demonstrates Token Theft (Signal 3: Session drift, Signal 1: Tor node, Signal 6: Impossible travel). Engine catches and blocks the transaction."
      }
    },
    {
