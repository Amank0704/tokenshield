            "exec": [
              "pm.test('Login successful — token saved', function() {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    const token = json.token || json.access_token || json.jwt;",
              "    const sessionId = json.session_id || json.sessionId;",
